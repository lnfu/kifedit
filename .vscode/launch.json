{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "kifedit extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/data"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/out/**/*.js"]
    }
  ]
}
